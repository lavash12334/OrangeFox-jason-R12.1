# Android fstab file for jason (Xiaomi Mi Note 3)
#
# This file has to stay in the standard AOSP format (five columns), because
# libfs_mgr parses it as well - the FBE code in the recovery calls
# ReadDefaultFstab(), and with the old TWRP four column format it fails with
# "Error parsing fs_mgr_options" and then "No mount point entry for /data",
# which makes fscrypt_initialize_systemwide_keys() fail and decryption
# impossible.
#
# The encryption flags mirror the ROM's own /vendor/etc/fstab.qcom: this device
# uses FBE v1 with the QTI inline crypto engine ("fileencryption=ice") and has
# no metadata encryption and no metadata partition.
#
# <src>                                       <mnt_point>          <type>  <mnt_flags>                                                          <fs_mgr_flags>
/dev/block/bootdevice/by-name/userdata        /data                ext4    nosuid,nodev,barrier=1,noauto_da_alloc,noatime,lazytime,errors=panic wait,check,quota,fileencryption=ice
/dev/block/bootdevice/by-name/userdata        /data                f2fs    nosuid,nodev,noatime,background_gc=off,fsync_mode=nobarrier          wait,check,quota,fileencryption=ice
/dev/block/bootdevice/by-name/system          /system              ext4    ro,barrier=1                                                         wait,display=System,backup=1,wipeingui
/dev/block/bootdevice/by-name/system          /system_image        emmc    defaults                                                             defaults,display=System_Image,backup=1,flashimg=1
/dev/block/bootdevice/by-name/cust            /vendor              ext4    ro,barrier=1                                                         wait,display=Vendor,backup=1,wipeingui
/dev/block/bootdevice/by-name/cust            /vendor_image        emmc    defaults                                                             defaults,display=Vendor_Image,backup=1,flashimg=1
/dev/block/bootdevice/by-name/cache           /cache               ext4    nosuid,nodev,noatime,barrier=1                                       wait
/dev/block/bootdevice/by-name/boot            /boot                emmc    defaults                                                             defaults,display=Boot,backup=1,flashimg=1
/dev/block/bootdevice/by-name/recovery        /recovery            emmc    defaults                                                             defaults,display=Recovery,backup=1,flashimg=1
/dev/block/bootdevice/by-name/misc            /misc                emmc    defaults                                                             defaults
/dev/block/bootdevice/by-name/persist         /persist             ext4    noatime,nosuid,nodev,barrier=1                                       wait,display=Persist,backup=1
/dev/block/bootdevice/by-name/dsp             /vendor/dsp          ext4    ro,nosuid,nodev,barrier=1                                            wait
/dev/block/bootdevice/by-name/modemst1        /efs1                emmc    defaults                                                             defaults,display=EFS,backup=1
/dev/block/bootdevice/by-name/modemst2        /efs2                emmc    defaults                                                             defaults,backup=1,subpartitionof=/efs1
/dev/block/bootdevice/by-name/fsg             /efsg                emmc    defaults                                                             defaults,backup=1,subpartitionof=/efs1
/dev/block/bootdevice/by-name/fsc             /efsc                emmc    defaults                                                             defaults,backup=1,subpartitionof=/efs1
# /usb_otg is defined in twrp.flags instead: the AOSP format has no column for an
# alternate block device, and USB sticks need both /dev/block/sda1 and
# /dev/block/sda (unpartitioned media).
