import /init.recovery.qcom_decrypt.rc

on init
    # Deliberately NOT setting prepdecrypt.setpatch: with a real recovery
    # partition prepdecrypt leaves SETPATCH=false and keeps the OS version and
    # patch level the build was made with, which is what the working
    # TWRP 3.7.0_11-0-jason-FBE build does. Those values now come from
    # PLATFORM_VERSION / PLATFORM_SECURITY_PATCH in vendorsetup.sh (13 and
    # 2099-12-31), so the script does not have to mount system/cust at all.
    # Full prepdecrypt logging: at the default level the script does not report
    # whether resetprop exists, which partitions it mounted, or whether setting
    # ro.build.version.release / .security_patch actually succeeded.
    setprop prepdecrypt.loglevel 2

    mkdir /config
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/bcdUSB 0x0200
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    # The kernel provides the configfs MTP function (verified on the device:
    # creating mtp.gs0 succeeds), so MTP can be built into the gadget below.
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}

# Battery percentage. The recovery reads the level through
# android::hardware::health::V2_0::IHealth::getService() - there is no sysfs
# fallback in the binary - and shows "!%" when the service is missing. The HAL
# is in the ramdisk (system/bin/android.hardware.health@2.1-service) but its
# init script marks it "disabled" and declares no "interface" lines, so
# hwservicemanager's lazy start cannot find it either:
#   init: Control message: Could not find 'android.hardware.health@2.0::IHealth/default'
#         for ctl.interface_start from pid: <hwservicemanager>
# Starting it by hand once hwservicemanager is up fixes the display. The default
# implementation reads /sys/class/power_supply/battery, which works here
# (capacity, status, health and technology all read correctly).
on property:hwservicemanager.ready=true
    start health-hal-2-1

# USB gadget configurations. The device has no vendor USB init in the ramdisk
# (TW_EXCLUDE_DEFAULT_USB_INIT := true), so every combination OrangeFox can ask
# for has to be handled here. The layout, the product ids and the order of
# operations are the ones from the third-party FBE TWRP for jason, which is
# known to work on this hardware; writing UDC "none" before rebuilding the
# configuration avoids the "Device or resource busy" failures we had before.
on property:sys.usb.config=adb
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb
    write /config/usb_gadget/g1/UDC "none"
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp,adb
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=mtp,adb
    write /config/usb_gadget/g1/UDC "none"
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idVendor 0x2717
    write /config/usb_gadget/g1/idProduct 0xff48
    symlink /config/usb_gadget/g1/functions/mtp.gs0 /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp
    write /config/usb_gadget/g1/UDC "none"
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idVendor 0x2717
    write /config/usb_gadget/g1/idProduct 0xff40
    symlink /config/usb_gadget/g1/functions/mtp.gs0 /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=sideload
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=sideload
    write /config/usb_gadget/g1/UDC "none"
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=none
    write /config/usb_gadget/g1/UDC "none"
    stop adbd
    setprop sys.usb.ffs.ready 0
    setprop sys.usb.state ${sys.usb.config}

on boot
    setprop sys.usb.config adb

on fs
    wait /dev/block/platform/soc/c0c4000.sdhci
    symlink /dev/block/platform/soc/c0c4000.sdhci /dev/block/bootdevice

    # prepdecrypt.sh mounts /dev/block/bootdevice/by-name/vendor to read the ROM's
    # build.prop; on this device that partition is called "cust", so without this
    # alias the script aborts with "Unable to mount vendor to temporary folder"
    # and never applies the ROM's security patch level, which keymaster needs.
    symlink /dev/block/platform/soc/c0c4000.sdhci/by-name/cust /dev/block/platform/soc/c0c4000.sdhci/by-name/vendor
    mkdir /cache 0775 system cache
    mount ext4 /dev/block/platform/soc/c0c4000.sdhci/by-name/cache /cache
    mkdir /cache/recovery 0775 system cache
    exec_background -- /system/bin/sh -c "dmesg -w > /cache/recovery/fox_live_dmesg.txt"

    # The decryption services live on the vendor partition (cust). Mount it out of
    # the way and expose only its bin/lib64 through symlinks: mounting it on top of
    # /vendor would also replace our VINTF manifest with the ROM's, and libvintf in
    # this tree cannot parse that one ("Unrecognized manifest.version 5.0"), which
    # kills keystore2 and the keymaster lookup.
    mkdir /mnt/vendor_cust 0755 root root
    mount ext4 /dev/block/platform/soc/c0c4000.sdhci/by-name/cust /mnt/vendor_cust ro
    symlink /mnt/vendor_cust/bin /vendor/bin
    symlink /mnt/vendor_cust/lib64 /vendor/lib64
    symlink /vendor/bin/qseecomd /system/bin/qseecomd
    symlink /vendor/bin/hw/android.hardware.keymaster@3.0-service /system/bin/android.hardware.keymaster@3.0-service
    symlink /vendor/bin/hw/android.hardware.gatekeeper@1.0-service /system/bin/android.hardware.gatekeeper@1.0-service

    # The synaptics touch driver probes at about 1.5s, later than the recovery
    # process starts, so wait for its input device before continuing to "on boot".
    wait /dev/input/event1 10

    # The QSEE listener libraries read their storage from /mnt/vendor/persist,
    # which is where the ROM mounts this partition; /persist alone is not enough.
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/persist 0771 root system
    mount ext4 /dev/block/platform/soc/c0c4000.sdhci/by-name/persist /mnt/vendor/persist

# The TrustZone clock is maintained by the vendor time daemon, using the offsets
# stored in /mnt/vendor/persist/time. It needs the QSEE listeners to be up first.
service jason-time_daemon /vendor/bin/time_daemon
    user root
    group root system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/sbin
    disabled
    seclabel u:r:recovery:s0

on property:vendor.sys.listeners.registered=true
    start jason-time_daemon

on property:sys.listeners.registered=true
    start jason-time_daemon

on property:sys.powerctl=*
    exec -- /system/bin/dd if=/dev/zero of=/dev/block/platform/soc/c0c4000.sdhci/by-name/misc bs=4096 count=256

# init.recovery.qcom_decrypt.rc only starts qseecomd when crypto.ready and
# hwservicemanager.ready line up, which does not always happen here, so start it
# from our own trigger as well. Without it the QSEE listeners never register and
# keymaster never comes up.
on property:crypto.ready=1
    start qseecomd
