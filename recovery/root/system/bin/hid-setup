#!/system/bin/sh
# hid-setup - Configure USB HID gadget for OrangeFox Recovery (Mi Note 3 / jason)
# Sets up HID functions (keyboard, mouse, consumer) under /config/usb_gadget/g1

set -e

GADGET_DIR="/config/usb_gadget/g1"
CONFIG_DIR="${GADGET_DIR}/configs/b.1"
DESC_DIR="/system/etc/hid"

KEYBOARD_FUNC="hid.gs1"
MOUSE_FUNC="hid.gs2"
CONSUMER_FUNC="hid.gs3"

KEYBOARD_DEV="${HID_KEYBOARD_DEV:-/dev/hidg1}"
MOUSE_DEV="${HID_MOUSE_DEV:-/dev/hidg2}"
CONSUMER_DEV="${HID_CONSUMER_DEV:-/dev/hidg3}"

MOUSE_REPORT_LEN=4
if [ "${HID_MOUSE_HSCROLL:-0}" = "1" ] || [ "${HID_MOUSE_REPORT_SIZE:-}" = "5" ]; then
    MOUSE_REPORT_LEN=5
fi

KEYBOARD_MINOR=1
MOUSE_MINOR=2
CONSUMER_MINOR=3
HIDG_MAJOR=243

echo "HID Recovery Setup: Checking gadget paths..."
if [ ! -d "$GADGET_DIR" ] || [ ! -d "$CONFIG_DIR" ]; then
    echo "Error: Standard gadget directory '$GADGET_DIR' or '$CONFIG_DIR' not found."
    exit 1
fi

CURRENT_UDC=$(cat "$GADGET_DIR/UDC" 2>/dev/null || true)
if [ -n "$CURRENT_UDC" ]; then
    echo "" > "$GADGET_DIR/UDC" 2>/dev/null || true
    sleep 1
fi

rm -f "${CONFIG_DIR}/${KEYBOARD_FUNC}" 2>/dev/null || true
rm -f "${CONFIG_DIR}/${MOUSE_FUNC}" 2>/dev/null || true
rm -f "${CONFIG_DIR}/${CONSUMER_FUNC}" 2>/dev/null || true

rmdir "${GADGET_DIR}/functions/${KEYBOARD_FUNC}" 2>/dev/null || true
rmdir "${GADGET_DIR}/functions/${MOUSE_FUNC}" 2>/dev/null || true
rmdir "${GADGET_DIR}/functions/${CONSUMER_FUNC}" 2>/dev/null || true

# 1. Keyboard
echo "Creating keyboard function ${KEYBOARD_FUNC}..."
mkdir -p "${GADGET_DIR}/functions/${KEYBOARD_FUNC}"
echo 1 > "${GADGET_DIR}/functions/${KEYBOARD_FUNC}/protocol"
echo 1 > "${GADGET_DIR}/functions/${KEYBOARD_FUNC}/subclass"
echo 8 > "${GADGET_DIR}/functions/${KEYBOARD_FUNC}/report_length"
cat "${DESC_DIR}/keyboard-desc.bin" > "${GADGET_DIR}/functions/${KEYBOARD_FUNC}/report_desc"

# 2. Mouse
echo "Creating mouse function ${MOUSE_FUNC}..."
mkdir -p "${GADGET_DIR}/functions/${MOUSE_FUNC}"
echo 2 > "${GADGET_DIR}/functions/${MOUSE_FUNC}/protocol"
echo 1 > "${GADGET_DIR}/functions/${MOUSE_FUNC}/subclass"
echo ${MOUSE_REPORT_LEN} > "${GADGET_DIR}/functions/${MOUSE_FUNC}/report_length"
if [ "$MOUSE_REPORT_LEN" = "5" ]; then
    printf '\x05\x01\x09\x02\xA1\x01\x09\x01\xA1\x00\x05\x09\x19\x01\x29\x03\x15\x00\x25\x01\x95\x03\x75\x01\x81\x02\x95\x01\x75\x05\x81\x03\x05\x01\x09\x30\x09\x31\x09\x38\x15\x81\x25\x7f\x75\x08\x95\x03\x81\x06\x05\x0C\x0A\x38\x02\x95\x01\x81\x06\xC0\xC0' > "${GADGET_DIR}/functions/${MOUSE_FUNC}/report_desc"
else
    cat "${DESC_DIR}/mouse-desc.bin" > "${GADGET_DIR}/functions/${MOUSE_FUNC}/report_desc"
fi

# 3. Consumer Control
echo "Creating consumer function ${CONSUMER_FUNC}..."
mkdir -p "${GADGET_DIR}/functions/${CONSUMER_FUNC}"
echo 0 > "${GADGET_DIR}/functions/${CONSUMER_FUNC}/protocol"
echo 0 > "${GADGET_DIR}/functions/${CONSUMER_FUNC}/subclass"
echo 2 > "${GADGET_DIR}/functions/${CONSUMER_FUNC}/report_length"
cat "${DESC_DIR}/consumer-desc.bin" > "${GADGET_DIR}/functions/${CONSUMER_FUNC}/report_desc"

# Link functions to b.1 config
ln -s "${GADGET_DIR}/functions/${KEYBOARD_FUNC}" "${CONFIG_DIR}/${KEYBOARD_FUNC}" || true
ln -s "${GADGET_DIR}/functions/${MOUSE_FUNC}" "${CONFIG_DIR}/${MOUSE_FUNC}" || true
ln -s "${GADGET_DIR}/functions/${CONSUMER_FUNC}" "${CONFIG_DIR}/${CONSUMER_FUNC}" || true

UDC_TO_ENABLE=""
if [ -n "$CURRENT_UDC" ] && [ -e "/sys/class/udc/${CURRENT_UDC}" ]; then
    UDC_TO_ENABLE="$CURRENT_UDC"
else
    for UDC in /sys/class/udc/*; do
        if [ -e "$UDC" ]; then
            UDC_TO_ENABLE=$(basename "$UDC")
            break
        fi
    done
fi

if [ -n "$UDC_TO_ENABLE" ]; then
    echo "$UDC_TO_ENABLE" > "$GADGET_DIR/UDC" || true
fi

# Create character device nodes
mknod ${KEYBOARD_DEV} c ${HIDG_MAJOR} ${KEYBOARD_MINOR} 2>/dev/null || true
mknod ${MOUSE_DEV} c ${HIDG_MAJOR} ${MOUSE_MINOR} 2>/dev/null || true
mknod ${CONSUMER_DEV} c ${HIDG_MAJOR} ${CONSUMER_MINOR} 2>/dev/null || true
chmod 666 ${KEYBOARD_DEV} ${MOUSE_DEV} ${CONSUMER_DEV} 2>/dev/null || true

echo "HID setup complete in recovery."
exit 0
